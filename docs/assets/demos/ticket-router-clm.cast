[0.0, "o", "$ bash /Users/xiaoyu/Documents/casual/work/clm-omni-demo.sh\r\n"]
[0.114120375, "o", "# application/task   ticket routing: 30 labelled tickets, five queues\r\n"]
[0.11416929199999998, "o", "# agents             s1a run ticket_router --model clm\r\n"]
[0.11417008299999998, "o", "# System1-Omni       omni-jev :8080  ->  clm-serve :8091  ->  Qwen3-8B on one RTX 4090\r\n"]
[0.11417054199999999, "o", "\r\n"]
[0.114225458, "o", "$ curl -s http://127.0.0.1:8080/health          # the frontend, ready, saying who is behind it\r\n"]
[0.32327970799999994, "o", "   {\"ok\": true, \"embedder\": true, \"models\": [\"clm-latest\", \"clm-raw\"]}\r\n"]
[0.32329549999999996, "o", "   vector cache on cuda\r\n"]
[0.32505541699999996, "o", "\r\n"]
[0.32511762499999997, "o", "$ the three tickets this run routes (seed 0, the first three of thirty)\r\n"]
[2.763371417, "o", "   t_a5a229edd810  label=logistics Track the new order\r\n"]
[2.763379125, "o", "      The duplicate charge on my previous order has been resolved. Today I only want the current l\r\n"]
[2.76338475, "o", "   t_c85ca34669b1  label=payment   Transaction status\r\n"]
[2.763385167, "o", "      My bank shows a charge, but the order is still marked unpaid. Please verify whether this tra\r\n"]
[2.763385458, "o", "   t_55ac1dd8d045  label=account   Forgotten password\r\n"]
[2.763386, "o", "      I forgot my password and cannot log in. Please help me recover my account.\r\n"]
[2.764218583, "o", "\r\n"]
[2.764275375, "o", "$ CLM_URL=http://127.0.0.1:8080 s1a run ticket_router --model clm --rethink off \\\r\n"]
[2.764285458, "o", "      --episodes 1 --seed 0 --batch-size 3 --max-steps 3 --showcase --log\r\n"]
[5.845742917000001, "o", "    1 human                  conf=0.96    75 ms\r\n"]
[5.845748708, "o", "    2 human                  conf=0.96    77 ms\r\n"]
[5.845749082999999, "o", "    3 human                  conf=0.91    88 ms\r\n"]
[5.845749874999999, "o", "{\"env\": \"ticket_router\", \"policy\": \"clm\", \"episodes\": 1, \"scored\": 1, \"mean_score\": 0.0, \"mean_score_ci95\": [0.0, 0.0], \"wins\": 0, \"losses\": 0, \"mean_steps\": 3, \"mean_elapsed_s\": 0.5, \"decisions\": 3, \"median_decision_ms\": 77, \"chat_calls\": 0, \"jev_input_tokens\": 0, \"chat_input_tokens\": 0, \"chat_output_tokens\": 0, \"chat_cache_tokens\": 0, \"invalid_keys\": 0, \"cost_usd\": 0.0, \"rethinks\": 0, \"errors\": 0, \"total_s\": 0.5, \"job_dir\": \"/Users/xiaoyu/Documents/casual/work/s1a-clm/evals/showcase/ticket_router/2026-10-07__23-01-36-908887__clm\"}\r\n"]
[5.84753225, "o", "\r\n"]
[5.847554583000001, "o", "$ the identity recorded in every tick, from the run's own episode.json\r\n"]
[6.067486375, "o", "   source clm | model clm-latest | ms 75\r\n"]
[6.067495083000001, "o", "   served_by {\"url\": \"http://127.0.0.1:8080\", \"models\": [\"clm-latest\", \"clm-raw\"], \"source\": \"health\"}\r\n"]
[6.0674959170000005, "o", "   routes   logistics->human, payment->human, account->human\r\n"]
[6.0674965830000005, "o", "   correct  0/3\r\n"]
[6.069722375, "o", "[exit 0]\r\n"]
