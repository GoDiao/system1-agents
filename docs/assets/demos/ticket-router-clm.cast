[0.09982550000000001, "o", "\r\n"]
[0.09990508399999998, "o", "$ curl -s http://127.0.0.1:8080/health          # the frontend, ready, saying who is behind it\r\n"]
[0.308688542, "o", "   {\"ok\": true, \"embedder\": true, \"models\": [\"clm-latest\", \"clm-raw\"]}\r\n"]
[0.308700292, "o", "   vector cache on cuda\r\n"]
[0.3099115, "o", "\r\n"]
